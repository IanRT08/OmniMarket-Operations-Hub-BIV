# --- Base de datos (PostgreSQL) ---------------------------------------------
# Runtime de la app: URL *pooled* (Neon: host con "-pooler"; PgBouncer en modo transacción).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/omnimarket?sslmode=verify-full"
# CLI de Prisma (migrate, db seed): conexión directa, sin pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/omnimarket?sslmode=verify-full"
# Conexiones del pool por instancia (recomendado ≥ 3: analytics y el Kanban lanzan consultas en paralelo).
# Con la BD local de `prisma dev` (PGlite, un solo proceso) usar 1: no soporta bien conexiones concurrentes.
DB_POOL_MAX=5

# --- Endpoints de auditoría (/api/test/*) -----------------------------------
# Si no es "true", todas las rutas /api/test/* responden 404.
ENABLE_TEST_ENDPOINTS=true
# Valor del header x-audit-token para POST /api/test/reset-data.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_TOKEN=
# Solo CI/E2E: si existe, reset-data crea una sesión de Better Auth con este token.
# NO definir en producción.
E2E_SESSION_TOKEN=

# --- Better Auth (OAuth 2.0: Google + GitHub) --------------------------------
# Generar con: npx @better-auth/cli secret  (o 32 bytes aleatorios en hex)
BETTER_AUTH_SECRET=
# URL pública de la app; los callbacks son <URL>/api/auth/callback/{google,github}
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Playwright --------------------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
